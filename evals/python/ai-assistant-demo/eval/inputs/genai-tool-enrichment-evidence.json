  "adapter_contract": {
    "public_interface": "opentelemetry.sdk.trace.export.SpanExporter.export(spans)",
    "view_constructor": "opentelemetry.sdk.trace.ReadableSpan(...)",
    "carrier_path": [
      "splunk_ao.metadata",
      "application.genai.required"
    ],
    "source_hook": "bind actual arguments, observe produced result/error, track produced_result independently; sanitize/bound copies before native input/output and metadata=; never change business arguments/returns",
    "merge": "The validation callback returns (validated_fields, explicit_owned_tool_content_removals). Remove only validated owned content fields on this canonical execute_tool record before merging replacement fields into a ReadableSpan view; keep every unrelated attribute and identity/lifecycle field. A merge-only adapter retains incompatible native defaults or fabricated output.",
    "preserved_fields": [
      "name",
      "trace_id",
      "span_id",
      "parent_span_id",
      "kind",
      "scope",
      "resource",
      "status",
      "start_time",
      "end_time",
      "events",
      "links",
      "dropped_attributes",
      "dropped_events",
      "dropped_links"
    ],
    "delivery": "delegate.export receives each SDK-created operation once; no new tracer/span IDs or wrapper; public force_flush/shutdown delegate while owned logger operations conclude first",
    "error_rule": "No-produced-result error keeps actual error status/type and attempted arguments/input; no successful result/output mapping or invented model finish_reason",
    "native_original_rule": "SDK native input/output and metadata must already be safe; redacted companions or export-only scrubbing cannot repair raw native records",
    "removal_allowlist": [
      "gen_ai.tool.call.arguments",
      "gen_ai.tool.call.result",
      "gen_ai.input.messages",
      "gen_ai.output.messages",
      "input.value",
      "output.value"
    ],
    "removal_rule": "Removal is source/policy/schema-validated for the current canonical tool only. Never use carrier-provided arbitrary names to remove identity, status, parent, model/provider metadata or unrelated attributes. Unsupported repair stays Partial. Invalid native null result may be removed only with truthful supported same-span OpenInference replacement or exact gap; actual no-result error removes spurious successful output.",
    "unrelated_span_rule": "Validation of an unrelated span returns ({},set()); delegate receives that identical original span, with no new view, metadata reinterpretation or field removal."
  },
