{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rubric.schema.json",
  "type": "object",
  "required": ["skill", "prompts"],
  "oneOf": [
    { "required": ["rubric"], "not": { "anyOf": [{ "required": ["rubric_base"] }, { "required": ["rubric_additions"] }] } },
    { "required": ["rubric_base"], "not": { "anyOf": [{ "required": ["rubric"] }, { "required": ["judge_prompt"] }, { "required": ["judge_inputs"] }, { "required": ["strict_rubric_output"] }] } }
  ],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string" },
    "skill": { "type": "string" },
    "skill_source": { "type": "string", "minLength": 1 },
    "language": { "type": "string" },
    "service": { "type": "string" },
    "prompts": { "$ref": "common.schema.json#/$defs/prompts" },
    "rubric_base": { "type": "string", "minLength": 1 },
    "rubric_additions": {
      "type": "object",
      "propertyNames": { "pattern": "^rubric-[1-9][0-9]*$" },
      "additionalProperties": { "type": "string", "minLength": 1 }
    },
    "rubric": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "judge_prompt": { "type": "string", "minLength": 1 },
    "strict_rubric_output": { "type": "boolean", "default": false },
    "judge_inputs": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "default": []
    }
  },
  "$defs": {
    "base": {
      "type": "object",
      "required": ["rubric", "judge_inputs", "strict_rubric_output"],
      "additionalProperties": false,
      "properties": {
        "rubric": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "judge_inputs": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "strict_rubric_output": { "type": "boolean" }
      }
    }
  }
}
