apiVersion: v1
kind: ConfigMap
metadata:
  name: @@COLLECTOR_CONFIGMAP_NAME_RAW@@
  namespace: @@NAMESPACE_RAW@@
  labels:
    app.kubernetes.io/name: splunk-otel-collector
    app.kubernetes.io/instance: @@RELEASE_NAME_RAW@@
    app.kubernetes.io/component: collector
    app.kubernetes.io/managed-by: otel-generate-app-collector-config
data:
  collector.yaml: |
    # Standalone Splunk OpenTelemetry Collector configuration.
    # Required environment variables: SPLUNK_REALM, SPLUNK_ACCESS_TOKEN.
    extensions:
      health_check:
        endpoint: 0.0.0.0:13133

    receivers:
      otlp:
        protocols:
          grpc:
            endpoint: 0.0.0.0:4317
          http:
            endpoint: 0.0.0.0:4318

    processors:
      memory_limiter:
        check_interval: 1s
        limit_percentage: 75
        spike_limit_percentage: 15
      batch:
        send_batch_size: 8192
        timeout: 5s

    exporters:
      otlphttp/splunk:
        traces_endpoint: "https://ingest.${env:SPLUNK_REALM}.observability.splunkcloud.com/v2/trace/otlp"
        metrics_endpoint: "https://ingest.${env:SPLUNK_REALM}.observability.splunkcloud.com/v2/datapoint/otlp"
        headers:
          X-SF-Token: "${env:SPLUNK_ACCESS_TOKEN}"
        compression: gzip
        retry_on_failure:
          enabled: true
          initial_interval: 5s
          max_interval: 30s
          max_elapsed_time: 300s
        sending_queue:
          enabled: true
          num_consumers: 10
          queue_size: 1000

    service:
      extensions: [health_check]
      pipelines:
        metrics:
          receivers: [otlp]
          processors: [memory_limiter, batch]
          exporters: [otlphttp/splunk]
        traces:
          receivers: [otlp]
          processors: [memory_limiter, batch]
          exporters: [otlphttp/splunk]
---
apiVersion: v1
kind: Service
metadata:
  name: @@COLLECTOR_SERVICE_NAME_RAW@@
  namespace: @@NAMESPACE_RAW@@
  labels:
    app.kubernetes.io/name: splunk-otel-collector
    app.kubernetes.io/instance: @@RELEASE_NAME_RAW@@
    app.kubernetes.io/component: collector
    app.kubernetes.io/managed-by: otel-generate-app-collector-config
spec:
  type: ClusterIP
  selector:
    app.kubernetes.io/name: splunk-otel-collector
    app.kubernetes.io/instance: @@RELEASE_NAME_RAW@@
    app.kubernetes.io/component: collector
  ports:
    - name: otlp
      port: 4317
      targetPort: otlp
      protocol: TCP
    - name: otlp-http
      port: 4318
      targetPort: otlp-http
      protocol: TCP
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: @@COLLECTOR_WORKLOAD_NAME_RAW@@
  namespace: @@NAMESPACE_RAW@@
  labels:
    app.kubernetes.io/name: splunk-otel-collector
    app.kubernetes.io/instance: @@RELEASE_NAME_RAW@@
    app.kubernetes.io/component: collector
    app.kubernetes.io/managed-by: otel-generate-app-collector-config
spec:
  replicas: 1
  selector:
    matchLabels:
      app.kubernetes.io/name: splunk-otel-collector
      app.kubernetes.io/instance: @@RELEASE_NAME_RAW@@
      app.kubernetes.io/component: collector
  template:
    metadata:
      labels:
        app.kubernetes.io/name: splunk-otel-collector
        app.kubernetes.io/instance: @@RELEASE_NAME_RAW@@
        app.kubernetes.io/component: collector
    spec:
      containers:
        - name: otel-collector
          image: @@COLLECTOR_IMAGE@@
          imagePullPolicy: IfNotPresent
          args:
            - --config=/conf/collector.yaml
          env:
            - name: SPLUNK_REALM
              value: @@REALM@@
            - name: SPLUNK_ACCESS_TOKEN
              valueFrom:
                secretKeyRef:
                  name: @@SECRET_NAME_RAW@@
                  key: splunk_observability_access_token
          ports:
            - name: otlp
              containerPort: 4317
              protocol: TCP
            - name: otlp-http
              containerPort: 4318
              protocol: TCP
            - name: health-check
              containerPort: 13133
              protocol: TCP
          readinessProbe:
            httpGet:
              path: /
              port: health-check
            initialDelaySeconds: 5
            periodSeconds: 10
          livenessProbe:
            httpGet:
              path: /
              port: health-check
            initialDelaySeconds: 10
            periodSeconds: 20
          resources:
            requests:
              cpu: 50m
              memory: 128Mi
            limits:
              cpu: 500m
              memory: 512Mi
          volumeMounts:
            - name: collector-config
              mountPath: /conf
              readOnly: true
      volumes:
        - name: collector-config
          configMap:
            name: @@COLLECTOR_CONFIGMAP_NAME_RAW@@
