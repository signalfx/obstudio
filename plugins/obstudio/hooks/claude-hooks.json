{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/bootstrap_obstudio.py\"",
            "commandWindows": "py -3 \"${CLAUDE_PLUGIN_ROOT}/hooks/bootstrap_obstudio.py\"",
            "statusMessage": "Bootstrapping Obstudio for Claude Code"
          }
        ]
      }
    ]
  }
}
