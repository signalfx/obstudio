{
  "skill": "otel-instrument",
  "prompts": [
    {
      "id": "runtime-preserving",
      "task": "Instrument the Express service in ./service with OpenTelemetry while preserving the existing runtime and startup command. Add auto-instrumentation only; ensure HTTP server spans, request-duration metrics, and existing application logs export to the local Observer during short runtime checks; do not add custom business spans."
    }
  ],
  "checks": [
    {
      "id": "observer-runtime-telemetry",
      "description": "Docker runtime emits Express HTTP server traces, duration metrics, and application logs to the local Observer.",
      "compose_file": "docker-compose.yml",
      "timeout_seconds": 300,
      "environment": {
        "CODEX_EVAL_OTEL_LOGS_EXPORTER": ""
      },
      "stop_services_before_validation": ["app"],
      "expect": {
        "endpoints": [
          {
            "id": "traces",
            "url": "/api/query/traces",
            "field_checks": {
              "service_names": ["node-express-basic"]
            },
            "detail_path_template": "/api/query/traces/{id}",
            "detail_id_field": "traceId",
            "detail_contains_all": [
              "http.request.method",
              "GET",
              "POST",
              "/health",
              "/tasks"
            ]
          },
          {
            "id": "metrics",
            "url": "/api/query/metrics",
            "contains_any": [
              "http.server.request.duration",
              "http.server.duration"
            ]
          },
          {
            "id": "logs",
            "url": "/api/query/logs",
            "record_checks": [
              {
                "id": "request-context-log",
                "match": {
                  "body": "runtime request completed"
                },
                "field_contains": {
                  "severityText": "WARN"
                },
                "field_equals": {
                  "resource.serviceName": "node-express-basic"
                },
                "non_empty": ["traceId", "spanId"],
                "exact_count": 1,
                "unique_by": ["traceId", "spanId"],
                "correlates_with_trace": true
              },
              {
                "id": "shutdown-log",
                "match": {
                  "body": "runtime shutdown completed"
                },
                "field_contains": {
                  "severityText": "WARN"
                },
                "field_equals": {
                  "resource.serviceName": "node-express-basic"
                },
                "exact_count": 1
              }
            ]
          }
        ],
        "service_logs": [
          {
            "id": "preserved-application-sink",
            "service_name": "app",
            "contains_all": [
              "runtime request completed",
              "runtime shutdown completed"
            ],
            "occurrences": {
              "runtime request completed": 1,
              "runtime shutdown completed": 1
            }
          }
        ]
      }
    },
    {
      "id": "observer-runtime-logs-opt-out",
      "description": "OTEL_LOGS_EXPORTER=none leaves Express console output intact while exporting no logs to Observer and preserving traces and metrics.",
      "compose_file": "docker-compose.yml",
      "timeout_seconds": 300,
      "environment": {
        "CODEX_EVAL_OTEL_LOGS_EXPORTER": "none"
      },
      "stop_services_before_validation": ["app"],
      "expect": {
        "endpoints": [
          {
            "id": "traces",
            "url": "/api/query/traces",
            "field_checks": {
              "service_names": ["node-express-basic"]
            },
            "detail_path_template": "/api/query/traces/{id}",
            "detail_id_field": "traceId",
            "detail_contains_all": [
              "http.request.method",
              "GET",
              "POST",
              "/health",
              "/tasks"
            ]
          },
          {
            "id": "metrics",
            "url": "/api/query/metrics",
            "contains_any": [
              "http.server.request.duration",
              "http.server.duration"
            ]
          },
          {
            "id": "logs",
            "url": "/api/query/logs",
            "record_checks": [
              {
                "id": "no-exported-application-logs",
                "match": {
                  "resource.serviceName": "node-express-basic"
                },
                "exact_count": 0
              }
            ]
          }
        ],
        "service_logs": [
          {
            "id": "opt-out-preserves-application-sink",
            "service_name": "app",
            "contains_all": [
              "runtime request completed",
              "runtime shutdown completed"
            ],
            "occurrences": {
              "runtime request completed": 1,
              "runtime shutdown completed": 1
            }
          }
        ]
      }
    }
  ]
}
