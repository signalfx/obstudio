{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["checks"],
  "additionalProperties": false,
  "properties": {
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "result", "notes", "evidence"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^rubric-[1-9][0-9]*$"},
          "result": {"enum": ["pass", "fail", "not_proven", "not_applicable"]},
          "notes": {"type": "string", "minLength": 1},
          "evidence": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
